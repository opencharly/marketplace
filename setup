#!/usr/bin/env bash
# GENERATED by charly marketplace generate — DO NOT EDIT.
# Regenerate this marketplace from a charly checkout:
#   ./setup           generate the corpus into this repo
#   ./setup --check   fail-closed drift gate (regeneration must be a no-op)
#
# This repo carries NO charly submodule on purpose: a declared submodule is initialized on
# every fetch, which dragged the whole charly repo into consumer trees. Keep a charly clone
# beside this repo (the umbrella layout), or point CHARLY_SRC at one.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
charly_src="${CHARLY_SRC:-$here/../charly}"
if [ ! -f "$charly_src/charly.yml" ]; then
    echo "setup: no charly checkout at $charly_src" >&2
    echo "  clone opencharly/charly next to this repo, or set CHARLY_SRC=/path/to/charly" >&2
    exit 1
fi
charly_src="$(cd "$charly_src" && pwd)"
# The charly CLI prescans the 'marketplace' word from the project root it runs in,
# so the command executes FROM the charly checkout; --root/--out stay explicit.
cd "$charly_src"
for arg in "$@"; do
    if [ "$arg" = "--check" ] || [ "$arg" = "--dry-run" ]; then
        exec charly marketplace drift --root "$charly_src" --out "$here"
    fi
done
exec charly marketplace generate --root "$charly_src" --out "$here"
