#!/usr/bin/env bash
# GENERATED by charly marketplace generate — DO NOT EDIT.
# Forwarding launcher preserving the README's ./setup <harness> <profile> [family] contract.
# The whole harness surface (skills, plugin.json, marketplace.json, profiles.json, .claude/ hooks
# + settings, the R0 dispatcher) is generated from candy config by 'charly marketplace generate';
# the profile/family selection no longer gates anything. --check runs the drift gate.
set -euo pipefail
cd "$(dirname "$0")/.."
for arg in "$@"; do
    if [ "$arg" = "--check" ] || [ "$arg" = "--dry-run" ]; then
        exec charly marketplace drift
    fi
done
exec charly marketplace generate
